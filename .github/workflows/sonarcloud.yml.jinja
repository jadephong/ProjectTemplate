name: SonarCloud Analysis

on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened]

jobs:
  sonarcloud:
    name: SonarCloud
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
      pull-requests: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
          cache: maven

      - name: Compile Java backend
        run: mvn -B compile -f backend/pom.xml

      - name: SonarCloud Scan
        uses: SonarSource/sonarcloud-github-action@master
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        with:
          args: >
            -Dsonar.projectKey=${{ vars.SONAR_PROJECT_KEY }}
            -Dsonar.organization=${{ vars.SONAR_ORG }}
            -Dsonar.java.binaries=backend/target/classes

      - name: Post SonarCloud issues comment
        if: github.event_name == 'pull_request'
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          SONAR_PROJECT_KEY: ${{ vars.SONAR_PROJECT_KEY }}
          REPO: ${{ github.repository }}
        run: |
          set -euo pipefail

          SONAR_URL="https://sonarcloud.io/api/issues/search?componentKeys=${SONAR_PROJECT_KEY}&pullRequest=${PR_NUMBER}&resolved=false&severities=BLOCKER,CRITICAL,MAJOR&ps=50"
          issues=$(curl -sf -u "${SONAR_TOKEN}:" "$SONAR_URL")

          total=$(echo "$issues" | jq '.total')

          old_id=$(gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
            --jq '[.[] | select(.body | startswith("## 🔍 SonarCloud Issues"))] | first | .id // empty')
          [[ -n "${old_id:-}" ]] && gh api -X DELETE "repos/${REPO}/issues/comments/${old_id}"

          if [[ "$total" == "0" || -z "$total" ]]; then
            clean_msg="## 🔍 SonarCloud Issues"$'\n'"✅ 本 PR 无新增 BLOCKER / CRITICAL / MAJOR 问题。"
            gh pr comment "$PR_NUMBER" --repo "$REPO" --body "$clean_msg"
            exit 0
          fi

          header="## 🔍 SonarCloud Issues (${total} 条新增)\n\n"
          header+="| Severity | Type | File | Line | Message |\n"
          header+="|---|---|---|---|---|\n"

          rows=""
          while IFS= read -r row; do
            sev=$(echo  "$row" | jq -r '.severity')
            type=$(echo "$row" | jq -r '.type')
            comp=$(echo "$row" | jq -r '.component' | sed 's|[^:]*:||')
            line=$(echo "$row" | jq -r '.line // "-"')
            msg=$(echo  "$row" | jq -r '.message')

            icon="🟡"
            [[ "$sev" == "BLOCKER" || "$sev" == "CRITICAL" ]] && icon="🔴"

            rows+="| ${icon} ${sev} | ${type} | \`${comp}\` | ${line} | ${msg} |\n"
          done < <(echo "$issues" | jq -c '.issues[]')

          body="${header}${rows}\n\n[查看完整分析 →](https://sonarcloud.io/project/overview?id=${SONAR_PROJECT_KEY})"
          printf "%b" "$body" | gh pr comment "$PR_NUMBER" --repo "$REPO" --body-file -
