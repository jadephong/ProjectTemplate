name: Auto Template Sync

on:
  issues:
    types: [opened]

jobs:
  sync:
    if: "startsWith(github.event.issue.title, 'chore: sync template')"
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Copier
        run: pip install copier

      - name: Run copier update
        run: copier update --defaults --trust

      - name: Create PR
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          if git diff --quiet && git diff --cached --quiet; then
            echo "No changes, nothing to sync"
            gh issue close {% raw %}${{ github.event.issue.number }}{% endraw %} \
              -r completed \
              -c "No changes to sync. Already up to date."
            exit 0
          fi

          BRANCH="sync/template-{% raw %}${{ github.event.issue.number }}{% endraw %}"
          git checkout -b "$BRANCH"
          git add -A
          git commit -m "chore: sync template updates" || echo "Nothing to commit"
          git push origin "$BRANCH"

          gh pr create \
            --title "chore: sync template" \
            --body "Auto-sync from template. Closes #{% raw %}${{ github.event.issue.number }}{% endraw %}" \
            --base main \
            --head "$BRANCH"

          gh issue close {% raw %}${{ github.event.issue.number }}{% endraw %} \
            -r completed \
            -c "Auto-synced: {% raw %}${{ github.server_url }}{% endraw %}/{% raw %}${{ github.repository }}{% endraw %}/pull/$(gh pr view --json number --jq .number)"
